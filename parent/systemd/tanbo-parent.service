[Unit]
Description=Tanbo dam water-level coordinator
After=network-online.target time-sync.target
Wants=network-online.target
# 無人運用なので再起動を諦めない(RestartSec で間隔を空ける)
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=tanbo
Group=tanbo
SupplementaryGroups=dialout i2c
ExecStart=/opt/tanbo/venv/bin/python -m tanbo -c /etc/tanbo/parent.toml
WorkingDirectory=/opt/tanbo
RuntimeDirectory=tanbo
RuntimeDirectoryMode=0750
StateDirectory=tanbo
Restart=always
RestartSec=20
WatchdogSec=300
TimeoutStopSec=90
# メインループ停止時は SIGABRT でスタックを残す
WatchdogSignal=SIGABRT

NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
